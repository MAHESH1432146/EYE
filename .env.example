```env
# ---- server (copy to server/.env) ----
PORT=5000
NODE_ENV=development

# Replace with your own MongoDB Atlas connection string locally
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/force_of_habit?retryWrites=true&w=majority

# Replace with a strong random secret in your actual .env file
JWT_SECRET=YOUR_PRIVATE_JWT_SECRET

JWT_EXPIRES_IN=12h

CLIENT_URL=http://localhost:5173

# Replace with your private invitation code in actual .env
RESEARCHER_INVITE_CODE=YOUR_PRIVATE_INVITE_CODE

# Used by npm run seed:researcher
SEED_RESEARCHER_EMAIL=researcher@example.com
SEED_RESEARCHER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD


# ---- client (copy to client/.env) ----
VITE_API_URL=http://localhost:5000/api
```